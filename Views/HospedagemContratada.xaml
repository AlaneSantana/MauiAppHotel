<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.HospedagemContratada"
             Title="HospedagemContratada"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">

    <VerticalStackLayout VerticalOptions="CenterAndExpand">

        <Label Text="Suíte Super Luxo"
               TextColor="Navy"
               FontFamily="Bold"
               FontSize="40"
               HorizontalTextAlignment="Center" />

        <Frame Margin="10">
            <HorizontalStackLayout Spacing="10">
                <HorizontalStackLayout Spacing="5">
                    <Label Text="Adultos: " 
                           TextColor="Yellow"/>
                    <Label Text="4"
                           TextColor="{StaticResource Gray200}" />
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="5">
                    <Label Text="Crianças: " 
                           TextColor="Yellow"/>
                    <Label Text="2"
                           TextColor="{StaticResource Gray200}" />
                </HorizontalStackLayout>
            </HorizontalStackLayout>
        </Frame>

        <Frame Margin="10">
            <Grid ColumnDefinitions="*, *, *"
                  RowDefinitions="Auto, Auto">
                <Label Grid.Row="0" Grid.Column="0" Text="Check-in:" TextColor="Yellow" />
                <Label Grid.Row="0" Grid.Column="1" Text="Check-out:" TextColor="Yellow" />
                <Label Grid.Row="0" Grid.Column="2" Text="Estadia:" TextColor="Yellow" />

                <Label Grid.Row="1" Grid.Column="0" Text="08/11/2023" />
                <Label Grid.Row="1" Grid.Column="1" Text="20/11/2023" />
                <Label Grid.Row="1" Grid.Column="2" Text="12 dias" />
            </Grid>
        </Frame>

        <Frame Margin="10">
            <HorizontalStackLayout Spacing="5">
                <Label Text="Valor Total:" TextColor="Yellow" />
                <Label Text="R$ 9.000,00" />
            </HorizontalStackLayout>
        </Frame>

        <Button Text="Voltar" 
               
                Clicked="Button_Clicked"
                BackgroundColor="#7B68EE"
                TextColor="Yellow"
                CornerRadius="15"
                Margin="10" 
                FontAttributes="Bold"
                FontSize="18"/>
        
    </VerticalStackLayout>
</ContentPage>